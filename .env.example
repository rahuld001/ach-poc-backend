# --- Server ---
PORT=4000

# Test-mode API key. The React client sends this as "Authorization: Bearer <key>".
API_KEY=sk_test_ach_poc_123

# --- PostgreSQL ---
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ach_poc

# Used to encrypt bank account numbers and Plaid access tokens at rest (any long random string).
ENCRYPTION_KEY=change-me-to-a-long-random-string

# --- Plaid sandbox (https://dashboard.plaid.com/developers/keys) ---
# Leave blank to use manual account entry + micro-deposits only.
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox

# --- Simulated originator / ODFI details written into the NACHA file ---
ODFI_ROUTING=011000015
ODFI_NAME=SIMULATED BANK
COMPANY_NAME=ACH POC INC
COMPANY_ID=1234567890

# --- Simulation behaviour ---
# How often pending transfers are batched into a NACHA file (seconds, 0 = manual only).
BATCH_INTERVAL_SECONDS=60
# How long the mock bank waits before settling / returning a submitted file (seconds).
MOCK_BANK_DELAY_SECONDS=15

# --- Limits (cents) ---
MAX_TRANSFER_CENTS=1000000
DAILY_LIMIT_CENTS=2500000
