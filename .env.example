# --- Server ---
PORT=4000

# Test-mode API key. The React client sends this as "Authorization: Bearer <key>".
API_KEY=sk_test_ach_poc_123

# --- PostgreSQL ---
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ach_poc

# Used to encrypt bank account numbers, Plaid access tokens and NACHA files at rest. Required (32+ random characters)
# when API_KEY is a live key; e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`.
ENCRYPTION_KEY=change-me-to-a-long-random-string

# --- Plaid sandbox (https://dashboard.plaid.com/developers/keys) ---
# Leave blank to use manual account entry + micro-deposits only.
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox

# --- Simulated originator / ODFI details written into the NACHA file ---
ODFI_ROUTING=011000015
ODFI_NAME=SIMULATED BANK
COMPANY_NAME=ACH POC INC
COMPANY_ID=1234567890

# --- Direct ACH: how files reach the bank ---
# mock = simulated ODFI in this process (default). sftp = real bank drop folder (npm install ssh2-sftp-client, set SFTP_*).
ODFI_TRANSPORT=mock
# LF or CRLF record separators, as the ODFI's origination guide requires.
ACH_LINE_ENDING=LF
# true adds an offsetting entry to your own account so every batch nets to zero (needs COMPANY_ACCOUNT_NUMBER).
ACH_BALANCED=false
COMPANY_ROUTING_NUMBER=
COMPANY_ACCOUNT_NUMBER=
# SFTP_HOST=sftp.yourbank.com
# SFTP_PORT=22
# SFTP_USERNAME=
# SFTP_PASSWORD=
# SFTP_OUTBOUND_DIR=/outbound
# SFTP_INBOUND_DIR=/inbound
# SFTP_PROCESSED_DIR=/inbound/processed

# --- Simulation behaviour ---
# How often pending entries are written into a NACHA file (seconds, 0 = manual only).
BATCH_INTERVAL_SECONDS=20
# Simulated bank clock: how long one banking day lasts, and how long the ODFI takes to acknowledge a file (seconds).
SIM_BANKING_DAY_SECONDS=20
SIM_ACK_SECONDS=5
# Increase sandbox only: delay before the simulated receiving bank settles or returns an Increase transfer (seconds).
MOCK_BANK_DELAY_SECONDS=15

# --- Limits (cents) ---
MAX_TRANSFER_CENTS=1000000
DAILY_LIMIT_CENTS=2500000

# --- Increase (optional real ACH rail, https://increase.com) ---
# Sandbox key from the Increase dashboard. Leave blank to use only the mock bank.
INCREASE_API_KEY=
# https://sandbox.increase.com (default) or https://api.increase.com for live money (refused while API_KEY is sk_test_)
INCREASE_BASE_URL=https://sandbox.increase.com
# Account that sends/receives the money. Blank = first open account.
INCREASE_ACCOUNT_ID=

# --- Real environment only (live API_KEY) ---
# Signs user sessions. Required (32+ random characters) with a live key.
SESSION_SECRET=
SESSION_HOURS=8
# First admin, created when the users table is empty. Remove the password from the environment after first start.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Bank cut-off times, US Eastern, comma separated (e.g. 10:30,14:00). Empty = send every batch interval.
ACH_CUTOFFS=
# false when a separate `npm run worker` process runs the jobs (recommended with a real bank).
RUN_JOBS=true
# Bank file naming: {companyId} {date} {time} {modifier}
ACH_FILE_NAME_TEMPLATE={companyId}_{date}_{modifier}.ach
# PGP (needs `npm install openpgp`): the bank's public key for outgoing files, ours for incoming.
ODFI_PGP_PUBLIC_KEY=
COMPANY_PGP_PRIVATE_KEY=
COMPANY_PGP_PASSPHRASE=
